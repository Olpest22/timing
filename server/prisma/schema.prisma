generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  email        String?       @unique @db.VarChar(255) // null для гостей
  passwordHash String?       @map("password_hash") @db.VarChar(255)
  timezone     String        @default("Europe/Moscow") @db.VarChar(50)
  theme        String        @default("graphite") @db.VarChar(20) // палитра интерфейса
  createdAt    DateTime      @default(now()) @map("created_at")
  organized    Event[]
  participants Participant[]

  @@map("users")
}

model Event {
  id           Int           @id @default(autoincrement())
  publicCode   String        @unique @map("public_code") @db.VarChar(12)
  organizerId  Int           @map("organizer_id")
  organizer    User          @relation(fields: [organizerId], references: [id])
  title        String        @db.VarChar(200)
  description  String?
  durationMin  Int           @map("duration_min")
  slotStepMin  Int           @default(30) @map("slot_step_min")
  timezone     String        @default("Europe/Moscow") @db.VarChar(50) // пояс, в котором ведётся сетка
  dateFrom     DateTime      @map("date_from") @db.Date
  dateTo       DateTime      @map("date_to") @db.Date
  dayStart     DateTime      @map("day_start") @db.Time
  dayEnd       DateTime      @map("day_end") @db.Time
  deadline     DateTime?
  status       EventStatus   @default(open)
  finalStart   DateTime?     @map("final_start")
  createdAt    DateTime      @default(now()) @map("created_at")
  participants Participant[]

  @@map("events")
}

enum EventStatus {
  open
  closed
}

model Participant {
  id           Int            @id @default(autoincrement())
  eventId      Int            @map("event_id")
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       Int            @map("user_id")
  user         User           @relation(fields: [userId], references: [id])
  isRequired   Boolean        @default(false) @map("is_required")
  responded    Boolean        @default(false)
  availability Availability[]

  @@unique([eventId, userId])
  @@map("participants")
}

model Availability {
  participantId Int         @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  slotStart     DateTime    @map("slot_start") // начало клетки, UTC
  level         Int         @db.SmallInt // 2 = свободен, 1 = если надо

  @@id([participantId, slotStart])
  @@map("availability")
}
